# Database
DATABASE_URL=postgresql://jobsuser:jobspass@localhost:5432/jobsdb

# Redis
REDIS_URL=redis://localhost:6379

# API Server
API_PORT=3000

# Worker
WORKER_CONCURRENCY=10
WORKER_STATS_PORT=3001
WORKER_TYPE=general
WORKER_ID=
WORKER_STATS_REPORTING_PERIOD_SECONDS=5
WORKER_STATS_REDIS_TTL_SECONDS=300

# Monitor Service
MONITOR_CRON_SCHEDULE=*/2 * * * *
CLEANUP_CRON_SCHEDULE=0 2 * * *
MAX_QUEUE_WAIT_MINUTES=30
JOB_TTL_DAYS_COMPLETED=7
JOB_TTL_DAYS_FAILED=30
JOB_TTL_DAYS_CANCELLED=7
MONITOR_PORT=3002
MONITOR_WORKER_STATS_QUERY_PERIOD_SECONDS=10

# Job Defaults
MAX_RETRY_ATTEMPTS=3
EXPONENTIAL_BACKOFF_BASE=2
JOB_TIMEOUT_MINUTES=5
